+/* D0.3: I2SM Start - the AE-9's ASI / PLL / stream setup (96 kHz, 32-bit, 6 ch) */
+static void ae9_post_dsp_asi_pll_setup(struct hda_codec *codec)
+{
+	struct ca0132_spec *spec = codec->spec;
