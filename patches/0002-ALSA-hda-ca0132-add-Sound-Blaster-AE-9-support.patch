+	ae9_dev49_write(codec, 0x0a, 0x06);
+	ae9_dev49_write(codec, 0x04, 0x15);
+	ae9_dev49_write(codec, 0x05, 0x15);
+	ae9_dev49_write(codec, 0x02, 0x15);
+	ae9_dev49_write(codec, 0x03, 0x15);
+	ae9_dev49_write(codec, 0x0a, 0x06);
