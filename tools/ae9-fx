    # ── handlers ──────────────────────────────────────────────────────────────

    def write(self, name, value):
        try:
            apply_ctl(name, value)
        except RuntimeError as exc:
            self.toast(f"{name}: {exc}")
            return False
        return True

    def on_page_selected(self, _listbox, row):
        if row is None:
            return
        title = row.get_title()
        self.stack.set_visible_child_name(title)
        self.content_title.set_title(title)
        self.content_page.set_title(title)

    def on_switch(self, row, _param, name):
        if self.loading:
            return
        self.write(name, "on" if row.get_active() else "off")
        if name == "Enable OutFX":
            self.fx_group.set_sensitive(row.get_active())
        if name == "Enable InFX Capture Switch":
            for r in getattr(self, "infx_rows", []):
                r.set_sensitive(row.get_active())

    def on_combo(self, row, _param, name):
        if self.loading:
            return
        item = row.get_selected_item()
        if item is not None:
            self.write(name, item.get_string())

    def on_format(self, row, _param):
        if self.loading:
            return
        idx = row.get_selected()
        if idx < 0 or idx >= len(FORMATS):
            return
        fmt = FORMATS[idx][1]
        try:
            write_format_conf(fmt)
        except OSError as exc:
            self.toast(f"format: {exc}")
            return
        self.toast(f"{fmt} saved — press Restart PipeWire to apply")

    def do_restart(self):
        if getattr(self, "_restarting", False):
            return
        self._restarting = True
        self.restart_btn.set_sensitive(False)
        threading.Thread(target=_restart_worker,
                         args=(mixer_state(), self._restart_done),
                         daemon=True).start()

    def _restart_done(self, msg):
        self._restarting = False
        self.restart_btn.set_sensitive(True)
        self.toast(msg)
        self.reload()
        return False

    def on_rate(self, row, _param, rate):
        if self.loading:
            return
        rates = [r for r in sorted(self.rate_rows) if self.rate_rows[r].get_active()]
        if not rates:
            self.toast("Keep at least one sample rate on")
            self.loading = True
            row.set_active(True)
            self.loading = False
            return
        try:
            apply_allowed_rates(rates)
        except (RuntimeError, OSError) as exc:
            self.toast(f"sample rate: {exc}")
            return
        self.refresh_format()

    def on_scale(self, scale, name):
        if self.loading:
            return
        # debounce: dragging a slider emits dozens of events and we do not want
        # dozens of writes going into the DSP
        if name in self.pending:
            GLib.source_remove(self.pending[name])

        def flush():
            self.pending.pop(name, None)
            self.write(name, int(scale.get_value()))
            return GLib.SOURCE_REMOVE

        self.pending[name] = GLib.timeout_add(180, flush)

    def toast(self, text):
        self.add_toast(Adw.Toast(title=text, timeout=4))

    # ── state ─────────────────────────────────────────────────────────────────

    def on_direct_mode(self, row, _param):
        if self.loading or not row.get_active():
            return
        try:
            if read("Enable OutFX")["switch"]:
                self.write("Enable OutFX", "off")
                self.toast("Direct Mode: SBX effects switched off")
        except (RuntimeError, OSError):
            pass

    def refresh_format(self):
        r = hardware_rate()
        self.hw_rate_row.set_subtitle(f"{r} Hz" if r else "idle")
        node = find_sink()
        if node is None:
            self.format_row.set_subtitle("AE-9 sink not found")
            self.clock_row.set_subtitle("—")
            return
        try:
            fmt, ch, rate = sink_format(node)
            rates = allowed_rates()
            clock = graph_rate()
        except (RuntimeError, OSError):
            return
        self.format_row.set_subtitle(
            f"{fmt} · {ch} ch · {rate} Hz" if fmt else "idle (device suspended)")
        allowed = " ".join(str(r) for r in rates) or "—"
        self.clock_row.set_subtitle(f"{clock or '—'} Hz · allowed: {allowed}")

    def _on_tick(self):
        self.refresh_format()
        return True

    def _on_close(self, *_args):
        if getattr(self, "_tick", None) is not None:
            GLib.source_remove(self._tick)
            self._tick = None
        return False

    def reload(self):
        self.loading = True
        try:
            for name, slots in self.widgets.items():
                try:
                    st = read(name)
                except RuntimeError:
                    continue
                if "switch" in slots and st["switch"] is not None:
                    slots["switch"].set_active(st["switch"])
                if "scale" in slots and st["value"] is not None:
                    slots["scale"].set_value(st["value"])
                if "combo" in slots and st["item"] in st["items"]:
                    slots["combo"].set_selected(st["items"].index(st["item"]))

            outfx = self.widgets.get("Enable OutFX", {}).get("switch")
            if outfx is not None:
                self.fx_group.set_sensitive(outfx.get_active())

            infx = self.widgets.get("Enable InFX Capture Switch", {}).get("switch")
            if infx is not None:
                for row in getattr(self, "infx_rows", []):
                    row.set_sensitive(infx.get_active())

            sel = acm_selector()
            self.acm_row.set_subtitle(sel or "unknown (not found in the log)")

            allowed = set(allowed_rates())
            for r, row in self.rate_rows.items():
                row.set_active(r in allowed)

            fmt = saved_format()
            values = [v for _label, v in FORMATS]
            if fmt in values:
                self.format_combo.set_selected(values.index(fmt))
            self.refresh_format()
        finally:
            self.loading = False

    def reset(self):
        for name, want in DEFAULTS.items():
            if isinstance(want, tuple):
                sw, lvl = want
                self.write(name, sw)
                if lvl is not None:
                    self.write(name, lvl)
            else:
                self.write(name, want)
        self.reload()
        self.toast("Reset to the manufacturer's defaults")


