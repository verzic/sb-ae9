def selftest():
    """Check the parsers without opening a window."""
    print(f"card: {CARD}")
    names = [p[0] for p in PROCESSORS] + [
        "Master", "AE-9 Output", "HP/Speaker Auto Detect", "Enable OutFX",
        "Surround Channel Config", "Full-Range Front Speakers",
        "Full-Range Rear Speakers", "Bass Redirection",
        "Bass Redirection Crossover", "AE-5: Sound Filter",
        "AE-5: Headphone Gain", "FX: Smart Volume Setting",
        "FX: X-Bass Crossover", "FX: Equalizer Preset", "EQ Band0",
        "Input Source", "Enable InFX Capture Switch",
        "FX: Voice Focus Capture Switch", "FX: Noise Reduction Capture Switch",
        "FX: Mic SVM Capture Switch", "SVM Level Capture Volume",
        "VoiceFX Capture Switch",
    ]
    for n in names:
        try:
            st = read(n)
        except RuntimeError as exc:
            print(f"  {n:32} ERROR {exc}")
            continue
        bits = []
        if st["switch"] is not None:
            bits.append("switch=" + ("on" if st["switch"] else "off"))
        if st["value"] is not None:
            bits.append(f"value={st['value']}")
        if st["item"] is not None:
            bits.append(f"item={st['item']!r} of {len(st['items'])}")
        print(f"  {n:32} {' '.join(bits)}")
    print(f"acm selector: {acm_selector()}")


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
    else:
        App().run(sys.argv)
