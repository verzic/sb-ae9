# ── ALSA ──────────────────────────────────────────────────────────────────────

def find_card():
    """The card's ALSA id. Stable across boots — the numeric index is not."""
    try:
        with open("/proc/asound/cards", encoding="utf-8") as fh:
            for line in fh:
                if "Creative" in line:
                    m = re.search(r"\[\s*(\S+)\s*\]", line)
                    if m:
                        return m.group(1)
    except OSError:
        pass
    return "Creative"


CARD = find_card()


def amixer(*args):
    p = subprocess.run(["amixer", "-c", CARD, *args],
                       capture_output=True, text=True)
    if p.returncode != 0:
        lines = (p.stderr or p.stdout).strip().splitlines()
        raise RuntimeError(lines[-1] if lines else "amixer failed")
    return p.stdout


def find_numid(name):
    """Map a control name to its card numid (works while capture is busy)."""
    out = amixer("controls")
    for line in out.splitlines():
        m = re.match(r"numid=(\d+),.*name='([^']*)'", line)
        if m and m.group(2) == name:
            return int(m.group(1))
    raise RuntimeError(f"control not found: {name}")


def read_numid(name):
    """Fallback reader for capture controls: sget fails while PipeWire owns
    the capture device, but cget on the card always works."""
    out = amixer("cget", f"numid={find_numid(name)}")
    st = {"switch": None, "value": None, "item": None, "items": []}
    st["items"] = re.findall(r"Item #\d+ '([^']*)'", out)
    m = re.search(r":\s*values=([^\n]+)", out)
    if not m:
        return st
    raw = m.group(1).strip()
    if raw in ("on", "off"):
        st["switch"] = raw == "on"
        return st
    first = raw.split(",")[0].strip()
    try:
        val = int(first)
    except ValueError:
        return st
    st["value"] = val
    if st["items"] and 0 <= val < len(st["items"]):
        st["item"] = st["items"][val]
    if "type=BOOLEAN" in out:
        st["switch"] = bool(val)
    return st


def read(name):
    """Read one control: switch, value and (for enums) the current item."""
    try:
        out = amixer("sget", name)
    except RuntimeError:
        return read_numid(name)
    st = {"switch": None, "value": None, "item": None, "items": []}

    m = re.search(r"Items: (.*)", out)
    if m:
        st["items"] = re.findall(r"'([^']*)'", m.group(1))
    m = re.search(r"Item\d+: '([^']*)'", out)
    if m:
        st["item"] = m.group(1)
    m = re.search(r"\[(on|off)\]", out)
    if m:
        st["switch"] = m.group(1) == "on"
    # amixer prints "Mono: Playback 31 [..]" for a pvolume control, but a bare
    # "Mono: 8 [7%]" for a joined volume with no direction (Bass Redirection
    # Crossover) — hence the optional direction word.
    m = re.search(r"(?:Mono|Front Left):\s+(?:\w+ )?(\d+)", out)
    if m:
        st["value"] = int(m.group(1))
    return st


def apply_ctl(name, value):
    try:
        amixer("sset", name, str(value))
    except RuntimeError:
        amixer("cset", f"numid={find_numid(name)}", str(value))


def acm_selector():
    """The ACM's selector, as the driver last reported it in the log."""
    try:
        p = subprocess.run(["journalctl", "-k", "-b", "--no-pager"],
                           capture_output=True, text=True)
    except OSError:
        return None
    for line in reversed(p.stdout.splitlines()):
        m = re.search(r"module selector (\w+)", line)
        if m:
            return m.group(1)
    return None


# ── PipeWire ──────────────────────────────────────────────────────────────────

# Where the rate policy is persisted; the Format page owns this file.
RATE_CONF = "~/.config/pipewire/pipewire.conf.d/10-ae9-rates.conf"
# Where the sample format is forced; applies on the next WirePlumber start.
FORMAT_CONF = "~/.config/wireplumber/wireplumber.conf.d/53-ae9-format.conf"
# The driver exposes exactly these two; there is no 24-bit ALSA format.
# 20/24-bit are folded into S32LE with an MSBITS_20/MSBITS_24 subformat.
FORMATS = [("32-bit (S32LE, incl. 24-bit)", "S32LE"),
           ("16-bit (S16LE)", "S16LE")]


def _pw(*args):
    p = subprocess.run(["pw-cli", *args], capture_output=True, text=True)
    if p.returncode != 0:
        lines = (p.stderr or p.stdout).strip().splitlines()
        raise RuntimeError(lines[-1] if lines else "pw-cli failed")
    return p.stdout


def find_sink():
    """PipeWire node id of the AE-9 analog sink (the card also exposes S/PDIF)."""
    try:
        p = subprocess.run(["pw-dump"], capture_output=True, text=True)
        data = json.loads(p.stdout or "[]")
    except (OSError, ValueError):
        return None
    devs = {o["id"] for o in data
            if o.get("info", {}).get("props", {}).get("device.vendor.id") == "0x1102"
            and o.get("info", {}).get("props", {}).get("device.product.id") == "0x0010"}
    for o in data:
        pr = o.get("info", {}).get("props", {})
        if (pr.get("media.class") == "Audio/Sink"
                and pr.get("device.id") in devs
                and "analog" in pr.get("node.name", "")
                and "iec958" not in pr.get("node.name", "")):
            return o["id"]
    return None


def sink_format(node):
    """(format, channels, rate) the sink is running right now."""
    out = _pw("enum-params", str(node), "Format")
    fmt = re.search(r"Audio:format \(65537\).*?AudioFormat:(\w+)\)", out, re.S)
    ch = re.search(r"Audio:channels \(65540\).*?Int (\d+)", out, re.S)
    rate = re.search(r"Audio:rate \(65539\).*?Int (\d+)", out, re.S)
    return (fmt.group(1) if fmt else None,
            int(ch.group(1)) if ch else None,
            int(rate.group(1)) if rate else None)


def hardware_rate():
    """The rate the analog playback PCM is running at, straight from ALSA."""
    try:
        with open(f"/proc/asound/{CARD}/pcm0p/sub0/hw_params",
                  encoding="utf-8") as fh:
            m = re.search(r"^rate:\s*(\d+)", fh.read(), re.M)
            return int(m.group(1)) if m else None
    except OSError:
        return None


def supported_rates(node):
    """The rates the ALSA node advertises, from its EnumFormat range."""
    out = _pw("enum-params", str(node), "EnumFormat")
    m = re.search(r"Audio:rate \(65539\).*?Choice:[^\n]*\n((?:\s*Int \d+\n)+)",
                  out, re.S)
    if not m:
        return []
    vals = [int(v) for v in re.findall(r"Int (\d+)", m.group(1))]
    if len(vals) < 3:
        return vals
    _default, lo, hi = vals[0], vals[1], vals[2]
    # the node exposes a min/max range; keep the standard rates inside it.
    # 176.4 kHz is left out: the AE-9's rate-following path has no working
    # descriptor for it.
    return [r for r in (32000, 44100, 48000, 88200, 96000, 192000)
            if lo <= r <= hi]


def _setting(key):
    try:
        p = subprocess.run(["pw-metadata", "-n", "settings"],
                           capture_output=True, text=True)
    except OSError:
        return None
    m = re.search(r"key:'" + re.escape(key) + r"' value:'([^']*)'", p.stdout)
    return m.group(1) if m else None


def allowed_rates():
    return [int(v) for v in re.findall(r"\d+", _setting("clock.allowed-rates") or "")]


def graph_rate():
    m = re.search(r"\d+", _setting("clock.rate") or "")
    return int(m.group(0)) if m else None


def apply_allowed_rates(rates):
    """Apply now (pw-metadata) and persist for the next PipeWire start."""
    val = "[ " + " ".join(str(r) for r in rates) + " ]"
    p = subprocess.run(["pw-metadata", "-n", "settings", "0",
                        "clock.allowed-rates", val],
                       capture_output=True, text=True)
    if p.returncode != 0:
        lines = (p.stderr or p.stdout).strip().splitlines()
        raise RuntimeError(lines[-1] if lines else "pw-metadata failed")

    # keep the default rate inside the allowed set, or PipeWire has to clamp it
    default = 48000 if 48000 in rates else rates[0]
    path = os.path.expanduser(RATE_CONF)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(
            "# Sound Blaster AE-9: native playback rates for the analog output.\n"
            "# Written by ae9-fx - applies at once and after every PipeWire restart.\n"
            "# The analog PCM tops out at 96 kHz; only S/PDIF reaches 192 kHz.\n"
            "context.properties = {\n"
            f"    default.clock.rate          = {default}\n"
            f"    default.clock.allowed-rates = [ {' '.join(str(r) for r in rates)} ]\n"
            "}\n")


def saved_format():
    """The format forced by the WirePlumber rule, if our file is present."""
    try:
        with open(os.path.expanduser(FORMAT_CONF), encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return None
    m = re.search(r'audio\.format\s*=\s*"(\w+)"', text)
    return m.group(1) if m else None


def write_format_conf(fmt):
    """Persist the sample format; the ALSA node picks it up on the next start."""
    path = os.path.expanduser(FORMAT_CONF)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(
            "# Sound Blaster AE-9: sample format forced on the analog sink.\n"
            "# Written by ae9-fx - takes effect after a WirePlumber restart.\n"
            "# 24-bit is carried inside S32LE (MSBITS_24); ALSA has no separate\n"
            "# 24-bit format for this codec.\n"
            "monitor.alsa.rules = [\n"
            "  {\n"
            "    matches = [\n"
            '      { node.name = "~alsa_output.*analog-stereo", '
            'alsa.mixer_name = "Creative Sound Blaster AE-9" }\n'
            "    ]\n"
            "    actions = {\n"
            "      update-props = {\n"
            f'        audio.format = "{fmt}"\n'
            "      }\n"
            "    }\n"
            "  }\n"
            "]\n")


def mixer_state():
    """Route/level/effects as they are now, so a restart can put them back."""
    try:
        ctl = ("AE-9 Output" if "'AE-9 Output'" in amixer("scontrols")
               else "Output Select")
        route = read(ctl)["item"] or "Headphone"
        master = read("Master")["value"] or 18
        outfx = bool(read("Enable OutFX")["switch"])
    except RuntimeError:
        return "AE-9 Output", "Headphone", 18, False
    return ctl, route, master, outfx


def restore_routing(ctl, route, master, outfx):
    """Undo WirePlumber's route restore, which mutes Front and moves the knob."""
    for c in ("PCM", "Front", "Surround"):
        try:
            amixer("sset", c, "unmute")   # PCM is volume-only: no switch
        except RuntimeError:
            pass
        amixer("sset", c, "100%")
    amixer("sset", "Master", "unmute")
    amixer("sset", "Master", str(master))
    amixer("sset", ctl, route)
    amixer("sset", "Enable OutFX", "on" if outfx else "off")


def _restart_worker(state, done):
    """Restart the audio stack, then restore what the route restore clobbers."""
    ctl, route, master, outfx = state
    try:
        subprocess.run(["systemctl", "--user", "restart",
                        "pipewire", "pipewire-pulse", "wireplumber"],
                       capture_output=True, text=True, timeout=30)
        for _ in range(40):
            if find_sink() is not None:
                break
            time.sleep(0.5)
        time.sleep(3)            # WirePlumber writes its route a few seconds late
        restore_routing(ctl, route, master, outfx)
        time.sleep(10)           # re-check after the late route restore
        try:
            if read(ctl)["item"] not in (None, route):
                restore_routing(ctl, route, master, outfx)
        except RuntimeError:
            pass
        msg = "PipeWire restarted; AE-9 routing restored"
    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
        msg = f"restart failed: {exc}"
    GLib.idle_add(done, msg)


