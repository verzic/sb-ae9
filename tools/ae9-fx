# The manufacturer's levels, for the reset button.
DEFAULTS = {
    "Master": 18,
    "AE-9 Output": "Headphone",
    "Enable OutFX": "on",
    "FX: Crystalizer": ("on", 65),
    "FX: Dialog Plus": ("on", 50),
    "FX: Smart Volume": ("on", 74),
    "FX: X-Bass": ("on", 50),
    "FX: Surround": ("off", 67),
    "FX: Equalizer": ("on", None),
