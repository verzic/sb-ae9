#!/usr/bin/env python3
"""ae9-fx — GUI for the Sound Blaster AE-9.

Drives the ALSA mixer elements of the card (id "Creative") through amixer:
volume and mute, output selection, the SBX effects, the EQ and the DAC filters.

Capture-side controls are deliberately absent (Enable InFX, FX: Voice Focus,
FX: Noise Reduction, FX: Mic SVM, Capture, Mic Boost, SVM Level, What U Hear,
VoiceFX, Wedge Angle, Input Source) — opening the capture path hard-locks the
machine (see the sb-ae9 README), so we do not hand out a button for it.

Requires python3-gobject, Gtk 4 and libadwaita (on Fedora:
`dnf install python3-gobject gtk4 libadwaita`). Run it straight from the tree,
or copy it somewhere on your PATH:

    install -Dm755 tools/ae9-fx ~/.local/bin/ae9-fx

For an entry in the application grid, drop this in
~/.local/share/applications/ae9-fx.desktop, with Exec pointing at an absolute
path (desktop entries do not expand $HOME):

    [Desktop Entry]
    Type=Application
    Name=Sound Blaster AE-9
    Comment=Volume, output, SBX effects and DAC filters for the AE-9
    Exec=/home/YOU/.local/bin/ae9-fx
    Icon=multimedia-volume-control
    Terminal=false
    Categories=AudioVideo;Audio;

Run with --selftest to print what it reads from every control, without opening
a window — the quickest way to tell an app bug from a driver state.
"""

import re
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from gi.repository import Adw, GLib, Gtk  # noqa: E402

APP_ID = "localhost.Ae9Fx"


# ── ALSA ──────────────────────────────────────────────────────────────────────

def find_card():
    """The card's ALSA id. Stable across boots — the numeric index is not."""
    try:
        with open("/proc/asound/cards", encoding="utf-8") as fh:
            for line in fh:
                if "Creative" in line:
                    m = re.search(r"\[\s*(\S+)\s*\]", line)
                    if m:
                        return m.group(1)
    except OSError:
        pass
    return "Creative"


CARD = find_card()


def amixer(*args):
    p = subprocess.run(["amixer", "-c", CARD, *args],
                       capture_output=True, text=True)
    if p.returncode != 0:
        lines = (p.stderr or p.stdout).strip().splitlines()
        raise RuntimeError(lines[-1] if lines else "amixer failed")
    return p.stdout


def read(name):
    """Read one control: switch, value and (for enums) the current item."""
    out = amixer("sget", name)
    st = {"switch": None, "value": None, "item": None, "items": []}

    m = re.search(r"Items: (.*)", out)
    if m:
        st["items"] = re.findall(r"'([^']*)'", m.group(1))
    m = re.search(r"Item\d+: '([^']*)'", out)
    if m:
        st["item"] = m.group(1)
    m = re.search(r"\[(on|off)\]", out)
    if m:
        st["switch"] = m.group(1) == "on"
    # amixer prints "Mono: Playback 31 [..]" for a pvolume control, but a bare
    # "Mono: 8 [7%]" for a joined volume with no direction (Bass Redirection
    # Crossover) — hence the optional direction word.
    m = re.search(r"(?:Mono|Front Left):\s+(?:\w+ )?(\d+)", out)
    if m:
        st["value"] = int(m.group(1))
    return st


def apply_ctl(name, value):
    amixer("sset", name, str(value))


def acm_selector():
    """The ACM's selector, as the driver last reported it in the log."""
    try:
        p = subprocess.run(["journalctl", "-k", "-b", "--no-pager"],
                           capture_output=True, text=True)
    except OSError:
        return None
    for line in reversed(p.stdout.splitlines()):
        m = re.search(r"module selector (\w+)", line)
        if m:
            return m.group(1)
    return None


# ── Data ──────────────────────────────────────────────────────────────────────

