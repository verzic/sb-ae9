    ("FX: Dialog Plus", "Dialog Plus",
     "Lifts the vocal / dialogue midrange",
     True, True, (True, 50)),
    ("FX: Smart Volume", "Smart Volume",
     "Loudness leveler: rides the gain up in quiet passages and down in loud ones",
     True, True, (True, 74)),
    ("FX: X-Bass", "X-Bass",
     "Bass enhancement below the crossover",
     True, True, (True, 50)),
    ("FX: Surround", "Surround",
     "Virtual surround / stereo widening",
     True, True, (False, 67)),
    ("FX: Equalizer", "Equalizer",
